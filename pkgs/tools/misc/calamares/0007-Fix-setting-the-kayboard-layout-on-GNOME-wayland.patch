From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Victor Fuentes <vmfuentes64@gmail.com>
Date: Thu, 31 Oct 2024 10:34:25 -0700
Subject: [PATCH] Fix setting the kayboard layout on GNOME wayland.

By default the module uses the setxkbmap, which will not change the
keyboard
---
 src/modules/keyboard/Config.cpp | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/src/modules/keyboard/Config.cpp b/src/modules/keyboard/Config.cpp
index 47c81a347..dd1ecb2b4 100644
--- a/src/modules/keyboard/Config.cpp
+++ b/src/modules/keyboard/Config.cpp
@@ -250,6 +250,12 @@ applyXkb( const BasicLayoutInfo& settings, AdditionalLayoutInfo& extra )
                                                   extra.groupSwitcher ) );
         QProcess::execute( "setxkbmap", basicArguments );
 
+        QString xkbmap = QString( "[('xkb','%1\%2'),('xkb','%3\%4')]").arg(
+                                  settings.selectedLayout, ((!settings.selectedVariant.isEmpty()) ? "+" + settings.selectedVariant : ""),
+                                  extra.additionalLayout, ((!extra.additionalVariant.isEmpty()) ? "+" + extra.additionalVariant : ""));
+        QProcess::execute( "sh", { "-c", "if command -v gsettings; then gsettings set org.gnome.desktop.input-sources sources \"$0\"; fi", xkbmap });
+
+
         cDebug() << "xkbmap selection changed to: " << settings.selectedLayout << '-' << settings.selectedVariant
                  << "(added " << extra.additionalLayout << "-" << extra.additionalVariant
                  << " since current layout is not ASCII-capable)";
@@ -258,6 +264,8 @@ applyXkb( const BasicLayoutInfo& settings, AdditionalLayoutInfo& extra )
     {
         basicArguments.append( xkbmap_layout_args( settings.selectedLayout, settings.selectedVariant ) );
         QProcess::execute( "setxkbmap", basicArguments );
+        QString xkbmap = QString( "[('xkb','%1\%2')]").arg( settings.selectedLayout, ((!settings.selectedVariant.isEmpty()) ? "+" + settings.selectedVariant: "") );
+        QProcess::execute( "sh", { "-c", "if command -v gsettings; then gsettings set org.gnome.desktop.input-sources sources \"$0\"; fi", xkbmap });
         cDebug() << "xkbmap selection changed to: " << settings.selectedLayout << '-' << settings.selectedVariant;
     }
 }
